# نسخ هذا الملف إلى .env ثم تعديل القيم
# Backend
DATABASE_URL=postgresql://postgres:postgres@db:5432/npo_ai
SECRET_KEY=change-me-for-production
# ENCRYPTION_KEY is optional: if empty, it is derived from SECRET_KEY.
# To generate a dedicated 32-byte base64 key, run:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# LLM Provider: openai | ollama | mock
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

# Embeddings: openai | fastembed | mock
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12V2
EMBEDDING_DIMENSION=384

# Arabic font for PDF reports
ARABIC_FONT_PATH=/usr/share/fonts/truetype/noto/NotoSansArabic-Regular.ttf

# API key (shared secret for backend routes; change in production)
API_KEY=change-me

# Frontend
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_API_KEY=change-me
BACKEND_URL=http://backend:8000
